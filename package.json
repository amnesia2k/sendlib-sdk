{
  "name": "@sendlib/node-sdk",
  "version": "0.1.1",
  "description": "Unofficial, community-maintained TypeScript SDK for the SendLib transactional email API.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "build": "bun run clean && tsup && tsc --project tsconfig.build.json && node ./scripts/build-cjs-declarations.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc --project tsconfig.examples.json",
    "check:examples": "node ./scripts/check-examples.mjs",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit",
    "test:contract": "vitest run test/contract",
    "test:integration": "vitest run test/integration --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "check:exports": "node ./scripts/check-exports.mjs",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version:packages": "changeset version && node ./scripts/date-changelog.mjs && bun install",
    "security:scan": "node ./scripts/security-scan.mjs",
    "pack:check": "publint --strict --pack bun && attw --pack . --profile strict",
    "smoke:package": "bun run build && node ./scripts/package-smoke.mjs",
    "ci": "bun run format:check && bun run build && bun run lint && bun run typecheck && bun run typecheck:examples && bun run check:exports && bun run check:examples && bun run test:coverage",
    "prepublishOnly": "bun run ci && bun run pack:check && bun run smoke:package"
  },
  "keywords": [
    "sendlib",
    "email",
    "transactional-email",
    "typescript",
    "nodejs"
  ],
  "author": {
    "name": "Olatilewa Olatoye",
    "email": "tilewa.olatoyee@gmail.com",
    "url": "https://github.com/amnesia2k"
  },
  "maintainers": [
    {
      "name": "Olatilewa Olatoye",
      "email": "tilewa.olatoyee@gmail.com"
    }
  ],
  "license": "MIT",
  "private": false,
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amnesia2k/sendlib-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/amnesia2k/sendlib-sdk/issues"
  },
  "homepage": "https://github.com/amnesia2k/sendlib-sdk#readme",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.12",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^0.5",
    "@changesets/cli": "^3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "tsup": "^8.5.1",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
