SENDLIB_API_KEY=sl_your_api_key_here

# Opt-in live tests send real email. Use only a maintainer-controlled account,
# recipient, sender, and dedicated dashboard template.
SENDLIB_RUN_INTEGRATION_TESTS=false
# Requires a SendLib Pro account and performs a real batch send.
SENDLIB_RUN_BATCH_INTEGRATION_TESTS=false
SENDLIB_TEST_RECIPIENT=sdk-test-recipient@example.com
SENDLIB_TEST_SENDER=sdk-test-sender@example.com
SENDLIB_TEST_TEMPLATE=sdk-integration-test

# Repository examples require a separate explicit real-send opt-in.
SENDLIB_RUN_EXAMPLE=false
SENDLIB_EXAMPLE_RECIPIENT=approved-recipient@example.com
SENDLIB_EXAMPLE_SENDER="Example App <connected-account@example.com>"
SENDLIB_EXAMPLE_ATTACHMENT_PATH=./path/to/document.pdf
SENDLIB_EXAMPLE_ATTACHMENT_TYPE=application/pdf
